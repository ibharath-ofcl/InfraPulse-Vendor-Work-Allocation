# ==============================================================================
# InfraPulse AI — Enterprise Production Environment Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env' for local Docker Compose or production deployment.
# 2. Never commit '.env' containing real secrets to version control.
# 3. All production passwords, keys, and tokens MUST be generated using cryptographically
#    secure random generators (e.g. `openssl rand -hex 32`).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL + POSTGIS DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Note: For production, use a dedicated least-privilege application user, not 'postgres'.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=infrapulse_db
DB_USER=infrapulse_app
DB_PASSWORD=REPLACE_WITH_SECURE_STRONG_DB_PASSWORD_MIN_24_CHARS

# Database Connection Pool Sizing (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 2. SPRING BOOT BACKEND CORE API
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/infrapulse_db
SPRING_DATASOURCE_USERNAME=infrapulse_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SECURE_STRONG_DB_PASSWORD_MIN_24_CHARS

# CORS Policy: Comma-separated list of fully-qualified authorized frontend origins.
# Never use '*' in production.
CORS_ALLOWED_ORIGINS=https://infrapulse.yourdomain.gov,https://app.infrapulse.yourdomain.gov

# Security & Authentication (JWT Signing Key)
# CRITICAL: Must be at least 256 bits (32 bytes) of entropy.
# Generate with: openssl rand -base64 64
INFRAPULSE_JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_256BIT_SECRET_STRING_AT_LEAST_64_CHARS_LONG!
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000         # 15 minutes (stateless token)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000     # 7 days (database-backed with rotation)

# Bootstrap Initial Platform Administrator (Only seeded if no admin exists in DB)
INFRAPULSE_ADMIN_EMAIL=admin@infrapulse.gov.in
INFRAPULSE_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_INITIAL_SEED_PASSWORD!
INFRAPULSE_ADMIN_NAME=Platform Administrator

# Evidence Storage Configuration
# Options: LOCAL (Docker persistent volume) or S3 (AWS S3 / MinIO object storage)
EVIDENCE_STORAGE_PROVIDER=LOCAL
EVIDENCE_LOCAL_DIR=/var/infrapulse/evidence
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# Internal AI Vision Service Integration
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. AI COMPUTER VISION INFERENCE SERVICE (FASTAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
ENVIRONMENT=production
AI_SERVICE_WORKERS=4
LOG_LEVEL=info
AI_MODEL_WEIGHTS_DIR=/app/models

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB APPLICATION (REACT + VITE + NGINX)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
# Client-accessible API Base URL (must be accessible from user's browser)
VITE_API_BASE_URL=https://infrapulse.yourdomain.gov/api
VITE_AI_SERVICE_URL=https://infrapulse.yourdomain.gov/ai
VITE_APP_ENV=production
