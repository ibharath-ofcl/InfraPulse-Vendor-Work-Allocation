# ==============================================================================
# InfraPulse AI - Environment Configuration Template (.env.example)
# Copy to .env for local Docker Compose execution. Never commit .env with secrets.
# ==============================================================================

# Database Settings (PostgreSQL + PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=infrapulse_db
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Boot Backend
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/infrapulse_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# AI Vision Service (FastAPI)
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development

# Frontend (Vite / Nginx)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_SERVICE_URL=http://localhost:8000
