# ==============================================================================
# InfraPulse AI — AI Computer Vision Service Environment Variables (.env.example)
# ==============================================================================

PORT=8000
ENVIRONMENT=production
AI_SERVICE_WORKERS=4
LOG_LEVEL=info

# CORS Whitelist for Direct Browser Uploads / Backend Gateways
CORS_ALLOWED_ORIGINS=https://infrapulse.yourdomain.gov,https://app.infrapulse.yourdomain.gov,http://backend:8080

# Machine Learning Model Weight Directories
AI_MODEL_WEIGHTS_DIR=/app/models
MAX_IMAGE_UPLOAD_BYTES=10485760   # 10MB
INFERENCE_TIMEOUT_SECONDS=30
