# ==============================================================================
# InfraPulse AI — Backend Spring Boot Environment Variables (.env.example)
# ==============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infrapulse_db
DB_USER=infrapulse_app
DB_PASSWORD=REPLACE_WITH_SECURE_STRONG_DB_PASSWORD

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/infrapulse_db
SPRING_DATASOURCE_USERNAME=infrapulse_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_SECURE_STRONG_DB_PASSWORD

# Connection Pool Sizing
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=20000

# CORS Whitelist (Comma-separated, explicit protocol and port)
CORS_ALLOWED_ORIGINS=https://infrapulse.yourdomain.gov,https://app.infrapulse.yourdomain.gov

# Authentication & Security
# Generate 256-bit key: openssl rand -base64 64
INFRAPULSE_JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_256BIT_SECRET_STRING_AT_LEAST_64_CHARS_LONG!
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000         # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000     # 7 days

# Initial Administrator Seed (Only provisioned if DB has 0 PLATFORM_ADMIN users)
INFRAPULSE_ADMIN_EMAIL=admin@infrapulse.gov.in
INFRAPULSE_ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_INITIAL_SEED_PASSWORD!
INFRAPULSE_ADMIN_NAME=Platform Administrator

# Evidence Storage
EVIDENCE_STORAGE_PROVIDER=LOCAL
EVIDENCE_LOCAL_DIR=uploads/evidence
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# AI Computer Vision Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000
AI_SERVICE_READ_TIMEOUT_MS=30000
