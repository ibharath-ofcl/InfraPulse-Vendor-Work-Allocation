# InfraPulse AI - Backend Environment Variables

SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infrapulse_db
DB_USER=postgres
DB_PASSWORD=postgres

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/infrapulse_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication & Security
INFRAPULSE_JWT_SECRET=change-this-to-a-very-strong-production-signing-key-with-at-least-256-bits-of-entropy!
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Bootstrap Initial Administrator (Created once on startup if no platform admin exists)
INFRAPULSE_ADMIN_EMAIL=admin@infrapulse.gov.in
INFRAPULSE_ADMIN_PASSWORD=Admin@InfraPulse2025!
INFRAPULSE_ADMIN_NAME=Platform Administrator
