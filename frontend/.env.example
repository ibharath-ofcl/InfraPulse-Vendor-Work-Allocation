# ==============================================================================
# InfraPulse AI — Frontend React + Vite Environment Variables (.env.example)
# ==============================================================================
# NOTE: All variables prefixed with 'VITE_' are embedded directly into the
# compiled client-side JavaScript bundle and are visible to any browser user.
# NEVER store passwords, private API keys, or backend secrets in this file!
# ==============================================================================

# Backend REST API Base URL (must be accessible from user's web browser)
# In production, this typically routes through Nginx reverse proxy: /api
VITE_API_BASE_URL=https://infrapulse.yourdomain.gov/api

# AI Computer Vision Service URL (if accessed directly, otherwise routed through proxy)
VITE_AI_SERVICE_URL=https://infrapulse.yourdomain.gov/ai

# Application Environment Indicator ('production' | 'staging' | 'development')
VITE_APP_ENV=production
